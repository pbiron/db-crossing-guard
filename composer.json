{
	"name": "shc/db-crossing-guard",
    "description": "Display various indicators to let admins know whether the DB connection is encrypted",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
            "name": "Paul V. Biron",
            "email": "paul@sparrowhawkcomputing.com",
            "homepage": "https://sparrowhawkcomputing.com",
            "role": "Developer"
        }
    ],
    "config" : {
		"sort-packages" : true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"repositories": [
		{
			"type": "path",
			"url": "/Users/pbiron/Documents/wp/shared-extensions/shared_composer_repos/shc/updater",
			"options": {
				"symlink": true
			}
		}
	],
	"minimum-stability" : "dev",
	"autoload": {
		"classmap": [
			"plugin.php",
			"includes"
		]
	},
	"require-dev": {
		"php-stubs/wp-cli-stubs": "dev-master",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpcompatibility/phpcompatibility-wp": " ^2",
		"szepeviktor/phpstan-wordpress": "*",
		"wp-coding-standards/wpcs" : "^3"
	},
	"require": {
		"shc/updater": "*"
	}
}
